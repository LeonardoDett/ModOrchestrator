{
  "name": "dettmann-ui",
  "version": "1.0.0-next.1",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.mjs"
    },
    "./theme-script": {
      "types": "./dist/theme/get-theme-script.d.ts",
      "import": "./dist/theme/get-theme-script.mjs"
    },
    "./theme.css": "./src/theme/tokens.css",
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "src/theme/tokens.css",
    "src/styles"
  ],
  "scripts": {
    "theme:build": "tsx scripts/theme/generate.ts",
    "theme:check": "vitest run src/theme",
    "theme:lint": "node scripts/theme/lint.mjs src",
    "theme": "npm run theme:build && npm run theme:check && npm run theme:lint",
    "skills:install": "node scripts/skills/install.mjs",
    "prebuild": "npm run theme",
    "build": "node --max-old-space-size=8192 node_modules/tsup/dist/cli-default.js && npm run build:css",
    "build:css": "tailwindcss -i ./src/theme/tokens.css -o ./dist/index.css --minify && node -e \"for(const f of require('fs').readdirSync('src/styles/fonts').filter(f=>f.endsWith('.woff2')))require('fs').copyFileSync('src/styles/fonts/'+f,'dist/'+f)\"",
    "dev": "tsup --watch",
    "playground": "vite --config playground/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p playground/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "verify": "npm run typecheck && npm run test -- --run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.4",
    "@tanstack/react-virtual": "^3.13.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "axe-core": "^4.13.0",
    "esbuild": "^0.27.7",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.0",
    "tsup": "^8.3.5",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.10"
  },
  "description": "Theme-first, composition-first React UI system with domain-ready primitives and patterns."
}
